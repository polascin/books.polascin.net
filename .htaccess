# Bezpečnostné nastavenia
Options -Indexes
ServerSignature Off

# Site-branded 404 (layout, noindex, recovery links) instead of the bare Apache page.
ErrorDocument 404 /404.php

# PWA manifest must advertise the dedicated MIME type. Without it (and with
# X-Content-Type-Options: nosniff) Chromium may ignore the install manifest.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Globálne bezpečnostné HTTP hlavičky
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # Content Security Policy. Stránka nenačítava nič z cudzieho pôvodu —
    # Tailwind, fonty aj skript sú lokálne — takže politika môže byť prísna
    # bez 'unsafe-inline' a 'unsafe-eval'.
    #   img-src data:  — .paper-texture v assets/css/style.css používa
    #                    inline SVG šum ako background-image
    #   JSON-LD v <script type="application/ld+json"> nie je spustiteľný skript,
    #   prehliadač ho pod script-src 'self' neblokuje.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://*.clarity.ms; style-src 'self'; img-src 'self' data: https://*.clarity.ms https://c.bing.com; font-src 'self'; connect-src 'self' https://*.clarity.ms; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

    # Cachovanie. CSS a JS chodia s ?v=<mtime> z assetUrl() v
    # includes/functions.php, fonty majú hash priamo v názve súboru — nová
    # verzia sa preto k návštevníkovi dostane okamžite aj pri dlhej platnosti.
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|gif|svg|ico|webp|avif)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # Dynamické stránky sa musia vždy overiť — obsah katalógu sa mení.
    # robots.php is excluded: it needs no-store (below), and two Cache-Control
    # headers (no-cache + no-store) were reaching clients.
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <Files "robots.php">
        Header unset Cache-Control
        Header set Cache-Control "no-store, max-age=0"
    </Files>
    # Crawl metadata must refresh with the deploy, not linger in edge caches.
    # no-store: bare /robots.txt was still served stale (473 B) after origin
    # already had the November file (590 B); query-string bypasses the edge.
    <FilesMatch "^(robots\.txt|sitemap\.xml|site\.webmanifest)$">
        Header unset ETag
        Header set Cache-Control "no-store, max-age=0"
    </FilesMatch>
    <Files "site.webmanifest">
        Header set Content-Type "application/manifest+json"
    </Files>
    <FilesMatch "^(robots\.txt|sitemap\.xml)$">
        FileETag None
    </FilesMatch>
</IfModule>

# Blokovanie .git a citlivých súborov
<FilesMatch "^\.git">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|pem|key|p12|pfx|log|sql|bak)$">
    Require all denied
</FilesMatch>

# Lokálne dev konfigy (PHPStan, PHP-CS-Fixer) — len lokálny vývoj, nie cez web
<FilesMatch "^(phpstan.*|\.php-cs-fixer.*)$">
    Require all denied
</FilesMatch>

# Interné Markdown dokumenty (.audit.md, .doaudit.md, README, DEPLOY, …) — nie cez web
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

# Build konfigurácia a Node závislosti — nepatria do webu (deploy ich vylučuje,
# toto je poistka pre prípad ručného nahratia).
<FilesMatch "^(package(-lock)?\.json|tailwind\.config\.js)$">
    Require all denied
</FilesMatch>

# PHP chyby sa návštevníkovi nikdy nezobrazujú — stack trace odhaľuje absolútne
# cesty na serveri. Logujú sa na server. Poistka ku configureErrorReporting()
# v includes/functions.php pre prípad, že .env na serveri chýba.
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# Blokovanie setup a private súborov
<Files "setup_db.php">
    Require all denied
</Files>

# Neverejné adresáre. Primárne ich blokujú vlastné .htaccess súbory
# (includes/, data/, tools/, hooks/); toto je poistka pre prípad, že by sa
# niektorý z nich na server nedostal, a RewriteRule nižšie je tretia vrstva.
<IfModule mod_alias.c>
    RedirectMatch 403 ^/(includes|data|tools|hooks)(/|$)
</IfModule>

# Bodkové súbory a adresáre okrem .well-known (ACME/SSL overenie). Pokrýva
# .prettierrc, .deployignore, .env.example aj čokoľvek pridané neskôr —
# .deployignore ich na server nenahrá, ale lokálny post-commit deploy hook
# (.git/hooks/deploy.sh) ho neberie do úvahy, takže sa tam dostať môžu.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known)" - [F,L]
    RewriteRule ^(\.git|\.claude|\.vscode|\.agents|\.codex|\.cursor|\.kilo|\.github|node_modules|includes|data|tools|hooks)(/.*)?$ - [F,L]
    # Canonical public pages are extensionless (/catalog, /about, …).
    # Outward: keep old .php bookmarks from competing in search results.
    RewriteRule ^(privacy|terms|catalog|about)\.php$ /$1 [R=301,L,QSA,NE]
    # Inward: serve the PHP file without exposing it in the address bar.
    RewriteRule ^(privacy|terms|catalog|about)/?$ $1.php [L,QSA]
    # Canonical home is /; keep /index.php from competing in search results.
    RewriteRule ^index\.php$ / [R=301,L]
    # Static /robots.txt can stick in the edge cache (origin 590 B, public 473 B).
    # Serve through PHP so each request reads the deployed file.
    RewriteRule ^robots\.txt$ /robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.xml [L]
</IfModule>
