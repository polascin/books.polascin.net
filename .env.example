# Zobrazovanie PHP chýb návštevníkovi. V produkcii nechajte false —
# stack trace odhaľuje absolútne cesty na serveri.
APP_DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=books_catalog
DB_USER=app_user
DB_PASS=change_me

# Kanonická adresa webu bez koncového lomítka. Používa ju getSiteUrl()
# pre canonical URL, Open Graph a JSON-LD.
SITE_URL=https://books.polascin.net