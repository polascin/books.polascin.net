# Force LF for shell scripts regardless of core.autocrlf
hooks/pre-commit   text eol=lf
hooks/pre-push     text eol=lf
hooks/install.sh   text eol=lf
*.sh               text eol=lf

# Web fonty sú binárne — žiadna konverzia koncov riadkov (poškodila by ich)
*.woff2            binary

# Generovaný build výstup — LF, aby bola kontrola drift-u v CI byte-stabilná
assets/css/tailwind.css  text eol=lf
assets/css/fonts.css     text eol=lf
