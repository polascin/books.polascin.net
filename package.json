{
  "name": "books-polascin-net",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling for books.polascin.net (self-hosted fonts, local Tailwind build).",
  "scripts": {
    "fonts": "node tools/fetch-fonts.mjs",
    "build:css": "tailwindcss -i tools/tailwind.src.css -o assets/css/tailwind.css --minify",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
