#!/usr/bin/env bash
# pre-push: second line of defence against pushed secrets

RED='\033[0;31m'
NC='\033[0m'

fail() {
    echo -e "${RED}[BLOCKED]${NC} $1" >&2
    exit 1
}

secret_patterns=(
    'DB_PASS=[^$#[:space:]]'
    'DB_PASSWORD=[^$#[:space:]]'
    'DB_USER=[^$#[:space:]]'
    'API_KEY=[^$#[:space:]]'
    'API_SECRET=[^$#[:space:]]'
    'SECRET_KEY=[^$#[:space:]]'
    'APP_SECRET=[^$#[:space:]]'
    'AUTH_TOKEN=[^$#[:space:]]'
    'ACCESS_TOKEN=[^$#[:space:]]'
    'PRIVATE_KEY=[^$#[:space:]]'
    'BEGIN [A-Z]* PRIVATE KEY'
    'AKIA[0-9A-Z]\{16\}'
    'AIza[0-9A-Za-z_-]\{35\}'
    'ghp_[A-Za-z0-9]\{36\}'
    'github_pat_[A-Za-z0-9_]\{82\}'
    'sk_live_[A-Za-z0-9]\{20,\}'
    'xox[baprs]-[0-9A-Za-z_-]\{10,\}'
)

while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "0000000000000000000000000000000000000000" ]] && continue
    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        range="$local_sha"
    else
        range="${remote_sha}..${local_sha}"
    fi
    # Exclusions are pathspecs rather than a grep/awk filter on the diff
    # header. The previous filter stripped the "diff --git" line for YAML
    # files, which is the very line the awk state machine needed in order to
    # recognise them - so YAML was never actually skipped.
    #   *.yml/*.yaml        - workflow files quote the pattern strings
    #   .env.example        - placeholders by design; README says to edit it
    #   pre-commit/pre-push - they carry this very pattern list
    exclude=(-- .
        ':(exclude)*.yml' ':(exclude)*.yaml'
        ':(exclude).env.example'
        ':(exclude)hooks/pre-commit' ':(exclude)hooks/pre-push')
    diff_output=$(git log -p "$range" "${exclude[@]}" 2>/dev/null | grep '^+' | grep -v '^+++')
    for pattern in "${secret_patterns[@]}"; do
        match=$(echo "$diff_output" | grep -m1 "$pattern" | head -c 200)
        if [[ -n "$match" ]]; then
            fail "Potential secret in commits being pushed:\n  $match\n  Use --no-verify only after confirming a false positive."
        fi
    done
done

exit 0