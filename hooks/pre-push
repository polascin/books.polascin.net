#!/usr/bin/env bash
# pre-push: second line of defence against pushed secrets

RED='\033[0;31m'
NC='\033[0m'

fail() {
    echo -e "${RED}[BLOCKED]${NC} $1" >&2
    exit 1
}

secret_patterns=(
    'DB_PASS=[^$#[:space:]]'
    'DB_PASSWORD=[^$#[:space:]]'
    'DB_USER=[^$#[:space:]]'
    'API_KEY=[^$#[:space:]]'
    'API_SECRET=[^$#[:space:]]'
    'SECRET_KEY=[^$#[:space:]]'
    'APP_SECRET=[^$#[:space:]]'
    'AUTH_TOKEN=[^$#[:space:]]'
    'ACCESS_TOKEN=[^$#[:space:]]'
    'PRIVATE_KEY=[^$#[:space:]]'
    'BEGIN [A-Z]* PRIVATE KEY'
    'AKIA[0-9A-Z]\{16\}'
    'AIza[0-9A-Za-z_-]\{35\}'
    'ghp_[A-Za-z0-9]\{36\}'
    'github_pat_[A-Za-z0-9_]\{82\}'
    'sk_live_[A-Za-z0-9]\{20,\}'
    'xox[baprs]-[0-9A-Za-z_-]\{10,\}'
)

while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "0000000000000000000000000000000000000000" ]] && continue
    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        range="$local_sha"
    else
        range="${remote_sha}..${local_sha}"
    fi
    # Scan only lines added in non-YAML files. .env.example and the hooks are
    # excluded for the same reasons as in pre-commit: placeholders by design,
    # and the pattern list itself.
    diff_output=$(git log -p "$range" -- . ':(exclude).env.example'         ':(exclude)hooks/pre-commit' ':(exclude)hooks/pre-push' 2>/dev/null \
        | grep -v '^diff --git.*\.\(yml\|yaml\)' \
        | awk '/^diff --git/{inYaml=(/\.(yml|yaml)$/)} !inYaml && /^\+/ && !/^\+\+\+/{print}')
    for pattern in "${secret_patterns[@]}"; do
        match=$(echo "$diff_output" | grep -m1 "$pattern" | head -c 200)
        if [[ -n "$match" ]]; then
            fail "Potential secret in commits being pushed:\n  $match\n  Use --no-verify only after confirming a false positive."
        fi
    done
done

exit 0